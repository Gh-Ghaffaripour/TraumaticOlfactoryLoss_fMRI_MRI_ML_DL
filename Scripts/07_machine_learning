# =============================================================================
# 2. Define Custom Metrics and Utility Functions
# =============================================================================
def specificity_score(y_true, y_pred):
    """
    Compute the specificity (true negative rate) score.
    """
    tn, fp, fn, tp = confusion_matrix(y_true, y_pred).ravel()
    return tn / (tn + fp + 1e-9)

# Create a scorer for specificity
specificity_scorer = make_scorer(specificity_score, greater_is_better=True)

def supports_roc_auc(model):
    """
    Check if a model supports ROC-AUC scoring by verifying
    that it has either predict_proba or decision_function.
    """
    return hasattr(model, "predict_proba") or hasattr(model, "decision_function")

