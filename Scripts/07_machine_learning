        'classifier__max_depth': Integer(1, 10)
    },
    "HistGradientBoosting": {
        'classifier__max_iter': Integer(50, 300),
        'classifier__learning_rate': Real(1e-3, 0.3, prior='log-uniform'),
        'classifier__max_depth': Integer(1, 10)
