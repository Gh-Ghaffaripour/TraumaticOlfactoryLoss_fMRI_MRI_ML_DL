    "import pandas as pd\n",
    "import re\n",
    "\n",
    "# ✅ Load the demographic data (File 1) and graph theory data (File 2)\n",
    "demographic_data = pd.read_excel(r\"D:\\image_group_data\\data\\Demografical_data.ods\")\n",
    "graph_data = pd.read_csv(r\"D:\\image_group_data\\team44\\Analysis\\graph_wholebrain_subR_missing_out_norm_fselect.csv\", dtype={\"Subject_ID\": str})\n",
    "\n",
    "# ✅ Function to extract subject number and group from Demographic Data\n",
    "def extract_subject_number_from_demographics(subject_name):\n",
    "    if isinstance(subject_name, str):  # Ensure it's a valid string\n",
    "        match = re.search(r'(HC|OLF)_sub(\\d+)', subject_name)  # Match \"HC_sub06\" or \"OLF_sub06\"\n",
    "        if match:\n",
    "            group = 'HC' if match.group(1) == 'HC' else 'OLF'  # Determine group\n",
    "            subject_number = str(int(match.group(2)))  # Convert subject number to string (remove leading zeros)\n",
    "            return group, subject_number\n",
    "    return None, None  # Return None if subject_name is invalid\n",
    "\n",
    "# ✅ Create a dictionary for TDI scores with (Subject_Number, Group) as the key\n",
    "def create_tdi_dict(demographic_data):\n",
    "    tdi_dict = {}\n",
    "    for _, row in demographic_data.iterrows():\n",
    "        subject_name = row['Subjects']\n",
    "        group, subject_number = extract_subject_number_from_demographics(subject_name)\n",
    "        if group and subject_number:\n",
    "            tdi_score = row['TDI']\n",
    "            tdi_dict[(subject_number, group)] = tdi_score  # Store TDI using (subject_number, group) as key\n",
    "    return tdi_dict\n",
    "\n",
    "# ✅ Function to update graph data with TDI score\n",
    "def update_graph_with_tdi(graph_data, tdi_dict):\n",
    "    def get_tdi_score(row):\n",
    "        subject_number = str(row['Subject_ID'])  # Convert to string for consistent matching\n",
    "        group = 'HC' if row['Label'] == 0 else 'OLF'  # Assign group based on Label (0 = Healthy, 1 = Diseased)\n",
    "\n",
    "        # Match subject number and group, then return the TDI score\n",
    "        return tdi_dict.get((subject_number, group), None)\n",
    "\n",
    "    # Apply the function to the graph data and create a new 'TDI' column\n",
    "    graph_data['TDI'] = graph_data.apply(get_tdi_score, axis=1)\n",
    "    return graph_data\n",
    "\n",
    "# ✅ Create the TDI dictionary from the demographic data\n",
    "tdi_dict = create_tdi_dict(demographic_data)\n",
    "\n",
    "# ✅ Update the graph data with TDI scores\n",
    "updated_graph_data = update_graph_with_tdi(graph_data, tdi_dict)\n",
    "\n",
    "# ✅ Save the updated graph data\n",
    "output_file = r'D:\\image_group_data\\team44\\Analysis\\regression_graph_theory_data.csv'\n",
    "updated_graph_data.to_csv(output_file, index=False)\n",
    "\n",
    "print(f\"✅ Graph theory data has been updated with TDI scores and saved to: {output_file}\")\n"
