    "\n",
    "# ✅ 5️⃣ Function to Replace Outliers Using Clipping\n",
    "def replace_outliers_per_feature(df, numerical_columns):\n",
    "    df_cleaned = df.copy()\n",
    "\n",
    "    # ✅ Exclude Subject_ID and Label from outlier handling\n",
    "    excluded_columns = [\"Subject_ID\", \"Label\"]\n",
    "    columns_to_clean = [col for col in numerical_columns if col not in excluded_columns]\n",
    "\n",
    "    for column in columns_to_clean:\n",
    "        Q1 = df[column].quantile(0.25)\n",
    "        Q3 = df[column].quantile(0.75)\n",
    "        IQR = Q3 - Q1\n",
    "        lower_bound = Q1 - 3 * IQR  # More strict filtering for extreme values\n",
    "        upper_bound = Q3 + 3 * IQR\n",
    "\n",
    "        # Clip extreme outliers instead of removing\n",
    "        df_cleaned[column] = np.clip(df_cleaned[column], lower_bound, upper_bound)\n",
    "\n",
    "        print(f\"🛠️ Replaced outliers in {column} using Clipping.\")\n",
    "\n",
    "    return df_cleaned\n",
    "\n",
    "\n",
    "# ✅ Apply Outlier Handling\n",
    "df_adjusted = replace_outliers_per_feature(df, numerical_columns)\n",
