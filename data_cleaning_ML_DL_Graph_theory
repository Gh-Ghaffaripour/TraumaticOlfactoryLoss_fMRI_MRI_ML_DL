    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# ✅ Load the cleaned dataset after outlier handling\n",
    "df_adjusted = pd.read_csv(r'D:\\image_group_data\\team44\\Analysis\\graph_wholebrain_subR_missing_out.csv')\n",
    "\n",
    "# ✅ 1️⃣ Identify Numerical Columns (Ignore Categorical Ones)\n",
    "numerical_columns = df_adjusted.select_dtypes(include=['number']).columns.tolist()\n",
    "\n",
    "# ✅ 2️⃣ Compute IQR for Each Feature and Detect Outliers (Again, after handling)\n",
    "outlier_dict = {}\n",
    "for column in numerical_columns:\n",
    "    Q1 = df_adjusted[column].quantile(0.25)\n",
    "    Q3 = df_adjusted[column].quantile(0.75)\n",
    "    IQR = Q3 - Q1\n",
    "    lower_bound = Q1 - 1.5 * IQR\n",
    "    upper_bound = Q3 + 1.5 * IQR\n",
    "\n",
    "    # Detect outliers in the new dataframe\n",
    "    outliers = df_adjusted[(df_adjusted[column] < lower_bound) | (df_adjusted[column] > upper_bound)][column]\n",
    "\n",
    "    if not outliers.empty:\n",
    "        outlier_dict[column] = len(outliers)\n",
    "\n",
    "# ✅ Convert Outlier Counts into a DataFrame (After Outlier Handling)\n",
    "outlier_df_after = pd.DataFrame(list(outlier_dict.items()), columns=['Feature', 'Outlier Count'])\n",
    "\n",
    "# ✅ Display the New Outlier Summary\n",
    "print(\"\\n🔍 Outlier Detection Summary (After Handling):\")\n",
    "print(outlier_df_after.sort_values(by=\"Outlier Count\", ascending=False))\n",
