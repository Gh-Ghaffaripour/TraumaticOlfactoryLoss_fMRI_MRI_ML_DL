   "source": [
    "import pandas as pd\n",
    "\n",
    "# Define file paths\n",
    "healthy_file = r\"D:\\image_group_data\\conn_graph_direct\\conn team 44\\h_whole_brain.csv\"\n",
    "diseased_file = r\"D:\\image_group_data\\conn_graph_direct\\conn team 44\\o_whole_brain.csv\"\n",
    "\n",
    "# Read CSV files with multi-row headers\n",
    "healthy_df = pd.read_csv(healthy_file, header=[0, 1])  # Read first two rows as header\n",
    "diseased_df = pd.read_csv(diseased_file, header=[0, 1])\n",
    "\n",
    "# Combine the multi-index headers into a single row by joining with '_'\n",
    "healthy_df.columns = ['_'.join(col).strip() for col in healthy_df.columns.values]\n",
    "diseased_df.columns = ['_'.join(col).strip() for col in diseased_df.columns.values]\n",
    "\n",
    "# Add a 'label' column: 0 for healthy, 1 for diseased\n",
    "healthy_df['Label'] = 0\n",
    "diseased_df['Label'] = 1\n",
    "\n",
    "# Merge the DataFrames by concatenating them\n",
    "merged_df = pd.concat([healthy_df, diseased_df], ignore_index=True)\n",
    "\n",
    "# Save the merged DataFrame to a new CSV file\n",
    "output_file = r\"D:\\image_group_data\\team44\\Analysis\\whole_brain.csv\"\n",
    "merged_df.to_csv(output_file, index=False)\n",
    "\n",
    "print(\"CSV files have been merged and saved successfully with corrected headers.\")\n",
    "merged_df"
   ],
